# Stripe secret key (Developers → API keys). Needed by /shop/thanks and /api/download to
# verify a purchase before serving the file. Use sk_test_… locally, sk_live_… in production.
STRIPE_SECRET_KEY=

# Production: private URL of the planner PDF (e.g. a Vercel Blob URL). When unset, the
# server reads private/<fileName> from disk, which only exists in local development.
PRODUCT_FILE_URL=
