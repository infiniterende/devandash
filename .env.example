# Stripe secret key (Developers → API keys). Needed by /shop/thanks and /api/download to
# verify a purchase before serving the file. Use sk_test_… locally, sk_live_… in production.
STRIPE_SECRET_KEY=

# Private Vercel Blob URL of the planner PDF (store: devandash-files). When unset, the
# server reads private/<fileName> from disk, which only exists in local development.
PRODUCT_FILE_URL=

# Read token for the private Blob store. Set automatically on Vercel when the store is
# connected to the project; locally, `vercel env pull .env.local` fills it in.
BLOB_READ_WRITE_TOKEN=
